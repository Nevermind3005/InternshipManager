@model server.Models.Mail.DocumentUploadedMail

<!DOCTYPE html>
<html lang="sk">
    <head>
        <meta charset="utf-8" />
        <style>
            body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
            .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
            .header { font-size: 20px; font-weight: bold; margin-bottom: 20px; color: #007bff; }
            .info-box {
                padding: 15px;
                margin: 15px 0;
                background: #f8f9fa;
                border-left: 4px solid #007bff;
                border-radius: 4px;
            }
            .info-label { font-weight: bold; color: #555; }
            .action-box {
                padding: 15px;
                margin: 20px 0;
                background: #fff3cd;
                border: 1px solid #ffc107;
                border-radius: 6px;
                text-align: center;
            }
            .note { font-size: 14px; color: #666; margin-top: 20px; }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">📄 Nové dokumenty na schválenie</div>

            <p>Dobrý deň @Model.RecipientFirstName,</p>

            <p>Študent nahral dokumenty k praxi, ktoré čakajú na Vaše schválenie.</p>

            <div class="info-box">
                <div><span class="info-label">Študent:</span> @Model.StudentFirstName @Model.StudentLastName</div>
                <div><span class="info-label">Názov praxe:</span> @Model.InternshipName</div>
                <div><span class="info-label">Spoločnosť:</span> @Model.CompanyName</div>
            </div>

            <div class="action-box">
                <strong>Prosím prihláste sa do systému InternshipManager, skontrolujte dokumenty a schváľte ich.</strong>
            </div>

            <div class="note">
                Toto je automatický email z InternshipManager systému.
            </div>
        </div>
    </body>
</html>
