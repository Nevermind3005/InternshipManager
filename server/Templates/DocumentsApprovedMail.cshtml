@model server.Models.Mail.DocumentsApprovedMail

<!DOCTYPE html>
<html lang="sk">
    <head>
        <meta charset="utf-8" />
        <style>
            body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
            .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
            .header { font-size: 20px; font-weight: bold; margin-bottom: 20px; color: #28a745; }
            .info-box {
                padding: 15px;
                margin: 15px 0;
                background: #f8f9fa;
                border-left: 4px solid #28a745;
                border-radius: 4px;
            }
            .info-label { font-weight: bold; color: #555; }
            .success-box {
                padding: 15px;
                margin: 20px 0;
                background: #d4edda;
                border: 1px solid #28a745;
                border-radius: 6px;
                text-align: center;
            }
            .warning-box {
                padding: 15px;
                margin: 20px 0;
                background: #fff3cd;
                border: 1px solid #ffc107;
                border-radius: 6px;
                text-align: center;
            }
            .note { font-size: 14px; color: #666; margin-top: 20px; }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">✅ Dokumenty boli schválené</div>

            <p>Dobrý deň @Model.RecipientFirstName,</p>

            <p>Firma schválila dokumenty k Vašej praxi.</p>

            <div class="info-box">
                <div><span class="info-label">Názov praxe:</span> @Model.InternshipName</div>
                <div><span class="info-label">Spoločnosť:</span> @Model.CompanyName</div>
            </div>

            @if (Model.AllDocumentsApproved && Model.SentToCoordinator)
            {
                <div class="success-box">
                    <strong>Všetky dokumenty boli schválené a prax bola odoslaná koordinátorovi na finálne schválenie.</strong>
                </div>
            }
            else
            {
                <div class="warning-box">
                    <strong>Dokumenty boli schválené, ale ešte je potrebné nahrať a schváliť ďalšie dokumenty.</strong>
                    <p>Prosím nahrajte zostávajúce dokumenty do systému.</p>
                </div>
            }

            <div class="note">
                Toto je automatický email z InternshipManager systému.
            </div>
        </div>
    </body>
</html>
