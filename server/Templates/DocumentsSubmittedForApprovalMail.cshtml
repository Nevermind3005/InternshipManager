@model server.Models.Mail.DocumentsSubmittedForApprovalMail

<!DOCTYPE html>
<html lang="sk">
    <head>
        <meta charset="utf-8" />
        <style>
            body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
            .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
            .header { font-size: 20px; font-weight: bold; margin-bottom: 20px; color: #007bff; }
            .info-box {
                padding: 15px;
                margin: 15px 0;
                background: #f8f9fa;
                border-left: 4px solid #007bff;
                border-radius: 4px;
            }
            .info-label { font-weight: bold; color: #555; }
            .note { font-size: 14px; color: #666; margin-top: 20px; }
            .action-text { font-weight: bold; color: #28a745; }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">📄 Dokumenty na schválenie</div>

            <p>Dobrý deň @Model.RepresentativeFirstName @Model.RepresentativeLastName,</p>

            <p>Študent <strong>@Model.StudentFirstName @Model.StudentLastName</strong> odoslal dokumenty na schválenie pre prax.</p>

            <div class="info-box">
                <div><span class="info-label">Prax:</span> @Model.InternshipName</div>
                <div><span class="info-label">Firma:</span> @Model.CompanyName</div>
                <div><span class="info-label">Študent:</span> @Model.StudentFirstName @Model.StudentLastName</div>
                <div><span class="info-label">Email študenta:</span> @Model.StudentEmail</div>
            </div>

            <p class="action-text">Prosím, prihláste sa do systému a skontrolujte dokumenty.</p>

            <div class="note">
                Toto je automatický email z InternHub systému.
            </div>
        </div>
    </body>
</html>
