@model server.Models.Mail.InternshipConfirmedForCoordinatorMail

<!DOCTYPE html>
<html lang="sk">
    <head>
        <meta charset="utf-8" />
        <style>
            body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
            .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
            .header { font-size: 20px; font-weight: bold; margin-bottom: 20px; color: #007bff; }
            .info-box {
                padding: 15px;
                margin: 15px 0;
                background: #f8f9fa;
                border-left: 4px solid #007bff;
                border-radius: 4px;
            }
            .section-title { font-weight: bold; color: #333; margin-top: 15px; margin-bottom: 10px; }
            .info-label { font-weight: bold; color: #555; }
            .note { font-size: 14px; color: #666; margin-top: 20px; }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">📋 Nová prax potvrdená firmou</div>

            <p>Dobrý deň,</p>

            <p>Nová prax bola potvrdená spoločnosťou a čaká na vaše schválenie.</p>

            <div class="info-box">
                <div class="section-title">Informácie o praxi</div>
                <div><span class="info-label">Názov:</span> @Model.InternshipName</div>
                <div><span class="info-label">Obdobie:</span> @Model.StartDate.ToString("dd.MM.yyyy") - @Model.EndDate.ToString("dd.MM.yyyy")</div>
                <div><span class="info-label">Rok/Semester:</span> @Model.Year / @Model.Semester</div>
                @if (!string.IsNullOrEmpty(Model.StudyProgramCode))
                {
                    <div><span class="info-label">Študijný program:</span> @Model.StudyProgramCode</div>
                }
            </div>

            <div class="info-box">
                <div class="section-title">Informácie o študentovi</div>
                <div><span class="info-label">Meno:</span> @Model.StudentFirstName @Model.StudentLastName</div>
                <div><span class="info-label">Email:</span> @Model.StudentEmail</div>
                @if (!string.IsNullOrEmpty(Model.StudentPhone))
                {
                    <div><span class="info-label">Telefón:</span> @Model.StudentPhone</div>
                }
            </div>

            <div class="info-box">
                <div class="section-title">Informácie o firme</div>
                <div><span class="info-label">Firma:</span> @Model.CompanyName</div>
                <div><span class="info-label">Zástupca:</span> @Model.CompanyRepresentativeName</div>
                <div><span class="info-label">Email zástupcu:</span> @Model.CompanyRepresentativeEmail</div>
            </div>

            <div class="note">
                Toto je automatický email z InternHub systému.
            </div>
        </div>
    </body>
</html>
