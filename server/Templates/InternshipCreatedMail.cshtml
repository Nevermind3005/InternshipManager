@model server.Models.Mail.InternshipCreatedMail

<!DOCTYPE html>
<html lang="sk">
    <head>
        <meta charset="utf-8" />
        <style>
            body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
            .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
            .header { font-size: 20px; font-weight: bold; margin-bottom: 20px; color: #007bff; }
            .info-box {
                padding: 15px;
                margin: 15px 0;
                background: #f8f9fa;
                border-left: 4px solid #007bff;
                border-radius: 4px;
            }
            .info-label { font-weight: bold; color: #555; }
            .action-box {
                padding: 15px;
                margin: 20px 0;
                background: #fff3cd;
                border: 1px solid #ffc107;
                border-radius: 6px;
                text-align: center;
            }
            .note { font-size: 14px; color: #666; margin-top: 20px; }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">📋 Nová prax čaká na schválenie</div>

            <p>Dobrý deň @Model.RepresentativeFirstName @Model.RepresentativeLastName,</p>

            <p>Informujeme Vás, že študent vytvoril novú prax vo Vašej spoločnosti, ktorá čaká na Vaše potvrdenie.</p>

            <div class="info-box">
                <div><span class="info-label">Študent:</span> @Model.StudentFirstName @Model.StudentLastName</div>
                <div><span class="info-label">Email študenta:</span> @Model.StudentEmail</div>
                <div><span class="info-label">Názov praxe:</span> @Model.InternshipName</div>
                <div><span class="info-label">Spoločnosť:</span> @Model.CompanyName</div>
                @if (!string.IsNullOrEmpty(Model.StudyProgramCode))
                {
                    <div><span class="info-label">Študijný program:</span> @Model.StudyProgramCode</div>
                }
                <div><span class="info-label">Začiatok:</span> @Model.StartDate.ToString("dd.MM.yyyy")</div>
                <div><span class="info-label">Koniec:</span> @Model.EndDate.ToString("dd.MM.yyyy")</div>
            </div>

            <div class="action-box">
                <strong>Prosím prihláste sa do systému InternshipManager a potvrďte alebo zamíetnite túto prax.</strong>
            </div>

            <p>Po Vašom schválení bude prax postúpená koordinátorovi praxí na konečné schválenie.</p>

            <div class="note">
                Toto je automatický email z InternshipManager systému.
            </div>
        </div>
    </body>
</html>
