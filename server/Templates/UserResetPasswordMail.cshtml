@model server.Models.Mail.UserResetPasswordMail

<!DOCTYPE html>
<html lang="sk">
    <head>
        <meta charset="utf-8" />
        <style>
            body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; }
            .container { max-width: 600px; margin: auto; padding: 20px; border: 1px solid #eee; border-radius: 8px; }
            .header { font-size: 20px; font-weight: bold; margin-bottom: 20px; }
            .password-box {
                display: inline-block;
                padding: 10px 15px;
                margin: 15px 0;
                background: #f4f4f4;
                border: 1px solid #ddd;
                border-radius: 6px;
                font-family: Consolas, monospace;
                font-size: 16px;
            }
            .note { font-size: 14px; color: #666; margin-top: 20px; }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="header">Obnovenie hesla</div>

            <p>Dobrý deň, @Model.FirstName @Model.LastName,</p>

            <p>Na základe vašej žiadosti o obnovenie hesla vám bolo vygenerované nové dočasné heslo pre prístup do systému <strong>InternshipManager</strong>.</p>

            <div class="password-box">@Model.GeneratedPassword</div>

            <p class="note">
                ⚠️ Po prihlásení s týmto dočasným heslom vás systém vyzve na zmenu hesla. Prosím, zvoľte si silné a jedinečné heslo, aby ste zabezpečili ochranu svojho účtu.
            </p>

            <p>Ďakujeme, že používate náš systém. Prajeme vám príjemný deň! 😊</p>
        </div>
    </body>
</html>