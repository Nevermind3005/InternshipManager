@server_HostAddress = http://localhost:5182

GET {{server_HostAddress}}/weatherforecast/
Accept: application/json

###

### ============================================
### PASSWORD RESET FLOW
### ============================================

### Step 1: Request password reset (forgot-password)
### Always returns 200 OK (even if email doesn't exist - security)
POST {{server_HostAddress}}/api/v1/auth/forgot-password
Content-Type: application/json

{
  "email": "handler@mail.com"
}

###

### Step 2: Reset password with token from email
### Replace TOKEN_FROM_EMAIL with actual token
POST {{server_HostAddress}}/api/v1/auth/reset-password
Content-Type: application/json

{
  "token": "TOKEN_FROM_EMAIL",
  "newPassword": "NewSecurePassword123"
}

###

### Login to test new password
POST {{server_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "handler@mail.com",
  "password": "NewSecurePassword123"
}

###
